# ---------------------------------------------------------------------------
# sandman — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Modal (sandbox execution) ---------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
SANDMAN_MODAL_APP_NAME=sandman-probes

# --- OpenAI (probe agents + Codex hotfix authoring) ------------------------
OPENAI_API_KEY=
# Codex authenticates with its own var; usually the same key.
CODEX_API_KEY=
# Wide fan-out uses the cheap model; hotfix authoring uses the strong one.
SANDMAN_MODEL_BREADTH=gpt-5.6-luna
SANDMAN_MODEL_HOTFIX=gpt-5.6-terra

# --- Greptile (autonomous review gate) -------------------------------------
GREPTILE_API_KEY=

# --- GitHub App -------------------------------------------------------------
# Create at https://github.com/settings/apps/new
#   * "Request user authorization (OAuth) during installation" = ON
#   * Permissions: Contents RW, Pull requests RW, Checks RW, Metadata RO
#   * Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents with literal \n, or point GITHUB_APP_PRIVATE_KEY_PATH at the file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Database ---------------------------------------------------------------
# Homebrew postgres listens on 5432; docker-compose.yml maps 5433 instead.
DATABASE_URL=postgresql://sandman:sandman@127.0.0.1:5432/sandman

# --- Secret envelope encryption --------------------------------------------
# 32 bytes, base64. Generate: openssl rand -base64 32
# Rotating this requires re-wrapping every stored data key, not re-encrypting
# every ciphertext -- that is the point of the envelope.
SANDMAN_KEK=

# --- cmem.ai / claude-mem (persistent agent memory) -------------------------
# Local worker port; default is 37700 + (uid % 100).
CLAUDE_MEM_WORKER_PORT=37702
SANDMAN_MEMORY_ENABLED=true

# --- Stripe (user-side billing) ---------------------------------------------
# Billing is fully implemented; it activates the moment these exist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Control plane ----------------------------------------------------------
SANDMAN_CONTROL_PLANE_URL=http://127.0.0.1:8000
APP_URL=http://localhost:3000

# --- Budget ceilings (overridable per project in sandman.config) -----------
SANDMAN_MAX_CONCURRENT_SANDBOXES=25
SANDMAN_MAX_CONCURRENT_LLM=8
SANDMAN_MAX_USD_PER_RUN=5.00

# --- web app ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
