# Safe default: uses the deterministic local runtime and does not contact Modal.
SANDMAN_DEFAULT_RUNTIME=demo
SANDMAN_MODAL_APP_NAME=sandman-production-probes
SANDMAN_CODEX_EXECUTABLE=codex
SANDMAN_CODEX_TIMEOUT_SECONDS=900
# Optional: persist investigations and hotfix artifacts across API/CLI restarts.
# SANDMAN_STATE_DATABASE=.sandman/state.db

# Only required for publishing branches, Checks, or pull requests.
GITHUB_TOKEN=
